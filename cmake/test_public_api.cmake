cmake_minimum_required(VERSION 3.23)
file(REAL_PATH "${GNEISS_BINARY_DIR}" build_root)
set(fixture "${build_root}/public-api-removal-fixture")
file(REAL_PATH "${fixture}" resolved)
cmake_path(IS_PREFIX build_root "${resolved}" NORMALIZE contained)
if(NOT contained OR resolved STREQUAL build_root)
  message(FATAL_ERROR "公共接口夹具目录越界")
endif()
file(REMOVE_RECURSE "${fixture}")
file(MAKE_DIRECTORY "${fixture}/include" "${fixture}/abi" "${fixture}/src/engine/api" "${fixture}/src/runtime/api")
file(COPY "${GNEISS_SOURCE_DIR}/include/gneiss" DESTINATION "${fixture}/include")
configure_file("${GNEISS_SOURCE_DIR}/abi/cpp-type-inventory.json" "${fixture}/abi/cpp-type-inventory.json" COPYONLY)
function(check expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DGNEISS_SOURCE_DIR=${fixture}"
    -P "${GNEISS_SOURCE_DIR}/cmake/check_public_api.cmake"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
  if(expected STREQUAL "pass" AND NOT status EQUAL 0)
    message(FATAL_ERROR "合法公共接口被拒绝：${error}")
  elseif(expected STREQUAL "fail" AND status EQUAL 0)
    message(FATAL_ERROR "非法公共接口未被拒绝")
  endif()
endfunction()
check(pass)
file(WRITE "${fixture}/src/runtime/api/fixture.cpp" "extern \"C\" void gneiss_forbidden() {}\n")
check(fail)
file(REMOVE "${fixture}/src/runtime/api/fixture.cpp")
foreach(content IN ITEMS "namespace gneiss::sdk {}" "namespace sdk {}" "using owner = gneiss::sdk::application;")
  file(WRITE "${fixture}/include/gneiss/forbidden.hpp" "${content}")
  check(fail)
endforeach()
file(REMOVE "${fixture}/include/gneiss/forbidden.hpp")
file(WRITE "${fixture}/include/gneiss/engine/application.hpp" "")
check(fail)
file(REMOVE "${fixture}/include/gneiss/engine/application.hpp")
file(WRITE "${fixture}/include/gneiss/extra.h" "typedef uint32_t gneiss_untracked_type;")
check(fail)
file(REMOVE "${fixture}/include/gneiss/extra.h")
check(pass)
