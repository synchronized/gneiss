@PACKAGE_INIT@

# 共享模块消费者只链接 Engine 导入库；静态链接仍需后端依赖。
if(@GNEISS_ENABLE_GRANIT_PLATFORM@ AND NOT @BUILD_SHARED_LIBS@)
  include(CMakeFindDependencyMacro)
  find_dependency(granit 0.67.0 CONFIG COMPONENTS Window RenderPipeline)
endif()

set(GNEISS_RUNTIME_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
set(GNEISS_LIBRARY_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
set(GNEISS_PROJECT_TEMPLATE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/gneiss/templates/game")

include("${CMAKE_CURRENT_LIST_DIR}/gneissTargets.cmake")
check_required_components(gneiss)
