@PACKAGE_INIT@

if(@GNEISS_ENABLE_GRANIT_PLATFORM@)
  include(CMakeFindDependencyMacro)
  find_dependency(granit 0.67.0 CONFIG COMPONENTS Window RenderPipeline)
endif()

if((@GNEISS_ENABLE_CAORS_INPUT@ OR @GNEISS_ENABLE_CAORS_MATERIAL@ OR @GNEISS_ENABLE_CAORS_MESH@) AND NOT @BUILD_SHARED_LIBS@)
  include(CMakeFindDependencyMacro)
  find_dependency(caors 0.4 CONFIG)
endif()

set(GNEISS_RUNTIME_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
set(GNEISS_LIBRARY_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
set(GNEISS_GAME_TEMPLATE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/gneiss/templates/game")

include("${CMAKE_CURRENT_LIST_DIR}/gneissTargets.cmake")
check_required_components(gneiss)
