include_guard(GLOBAL)
set(GNEISS_DEPENDENCY_SOURCE_CACHE_DIR "${CMAKE_SOURCE_DIR}/vendor/cache" CACHE PATH
    "第三方归档及源码缓存，不包含构建产物")
option(GNEISS_DEPENDENCY_OFFLINE "依赖源码只使用已有缓存，不下载" OFF)

# 同一缓存项持锁至函数返回。临时文件失败时保留以诊断，不删除用户目录。
function(gneiss_cached_archive name url sha256 marker output)
  string(LENGTH "${sha256}" hash_length)
  if(NOT name MATCHES "^[A-Za-z0-9_-]+$" OR NOT hash_length EQUAL 64
      OR NOT sha256 MATCHES "^[0-9a-f]+$" OR NOT marker MATCHES "^[A-Za-z0-9_.-]+$")
    message(FATAL_ERROR "依赖缓存参数无效：${name}")
  endif()
  get_filename_component(root "${GNEISS_DEPENDENCY_SOURCE_CACHE_DIR}" ABSOLUTE)
  set(key "${name}-${sha256}")
  set(source "${root}/sources/${name}/${sha256}")
  set(archive "${root}/archives/${key}.tar.gz")
  file(MAKE_DIRECTORY "${root}/locks" "${root}/archives" "${root}/staging" "${root}/sources/${name}")
  file(LOCK "${root}/locks/${key}.lock" GUARD FUNCTION TIMEOUT 300 RESULT_VARIABLE locked)
  if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "依赖 ${name} 缓存锁失败：${root}：${locked}")
  endif()
  if(EXISTS "${source}/.gneiss-source-complete" AND EXISTS "${source}/${marker}")
    file(READ "${source}/.gneiss-source-complete" receipt)
    if(receipt STREQUAL "${sha256}\n")
      set(${output} "${source}" PARENT_SCOPE)
      return()
    endif()
  endif()
  if(EXISTS "${source}")
    message(FATAL_ERROR "依赖 ${name} 源码缓存不完整，请移走后重试：${source}")
  endif()
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
  set(stage "${root}/staging/${key}-${nonce}")
  file(MAKE_DIRECTORY "${stage}")
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" actual)
    if(NOT actual STREQUAL sha256)
      message(FATAL_ERROR "依赖 ${name} 归档摘要不匹配，请移走后重试：${archive}")
    endif()
  else()
    if(GNEISS_DEPENDENCY_OFFLINE)
      message(FATAL_ERROR "离线依赖 ${name} 缓存缺失：${root}")
    endif()
    file(DOWNLOAD "${url}" "${stage}/download.tar.gz" TLS_VERIFY ON STATUS status TIMEOUT 300)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "依赖 ${name} 下载失败：${status}；缓存：${root}")
    endif()
    file(SHA256 "${stage}/download.tar.gz" actual)
    if(NOT actual STREQUAL sha256)
      message(FATAL_ERROR "依赖 ${name} 下载摘要不匹配：${stage}")
    endif()
    file(RENAME "${stage}/download.tar.gz" "${archive}")
  endif()
  file(MAKE_DIRECTORY "${stage}/unpack")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${archive}"
    WORKING_DIRECTORY "${stage}/unpack" RESULT_VARIABLE extracted ERROR_VARIABLE error)
  if(NOT extracted STREQUAL "0")
    message(FATAL_ERROR "依赖 ${name} 解压失败：${error}；缓存：${stage}")
  endif()
  file(GLOB children LIST_DIRECTORIES TRUE "${stage}/unpack/*")
  list(LENGTH children count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "依赖 ${name} 归档应有单一根目录：${stage}")
  endif()
  list(GET children 0 unpacked)
  if(NOT IS_DIRECTORY "${unpacked}" OR NOT EXISTS "${unpacked}/${marker}")
    message(FATAL_ERROR "依赖 ${name} 缺少入口 ${marker}：${stage}")
  endif()
  file(WRITE "${unpacked}/.gneiss-source-complete" "${sha256}\n")
  file(RENAME "${unpacked}" "${source}")
  set(${output} "${source}" PARENT_SCOPE)
endfunction()
